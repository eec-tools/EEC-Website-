# PORT is only used by `node server.js` for local dev — Vercel ignores it and
# routes requests directly to api/index.js.
PORT=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
USE_IN_MEMORY_DB=
JWT_SECRET=
APP_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
COOKIE_SECURE=
FRONTEND_URL=
CORS_ORIGINS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
AWS_REGION=
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# Public enquiry forms. Both have working defaults in src/config/env.js.
SERVICE_REQUEST_NOTIFY_EMAIL=
SERVICE_REQUEST_SHEET_WEBHOOK_URL=
# EEC Social Engine (/studio). See docs/SOCIAL_ENGINE.md.
# Buffer personal API key (publish.buffer.com/settings/api). Never put it anywhere else.
BUFFER_API_KEY=
# Long random secret: the connector URL for Claude is /api/social/mcp/<SOCIAL_AGENT_KEY>.
SOCIAL_AGENT_KEY=
# Long random secret for the clock (Vercel cron sends it as a Bearer token; GitHub Actions too).
CRON_SECRET=
# Public base URL of this backend, used in slide image links sent to Buffer.
SOCIAL_PUBLIC_BASE_URL=https://eec-website-backend.vercel.app
